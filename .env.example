# Supabase (client sync + auth)

NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — use sb_secret_… from Supabase Project Settings → API

SUPABASE_SECRET_KEY=



# Auth.js (Google sign-in for cloud sync)

# Generate with: openssl rand -base64 32

AUTH_SECRET=

AUTH_GOOGLE_ID=

AUTH_GOOGLE_SECRET=

# Legacy aliases also supported: CLIENT_ID, CLIENT_SECRET, BETTER_AUTH_SECRET, NEXTAUTH_SECRET



# Optional — absolute site URL (OG, share links). Canonical host is www.
# Apex matomari.com 308-redirects to www.matomari.com (configure in Vercel/DNS).
# Manual DNS / Vercel domain / Google OAuth redirects are outside this repo.
# NEXT_PUBLIC_SITE_URL=https://www.matomari.com

# Online-first cloud mode (default on). Set to 0 to temporarily restore local-first sync.

# NEXT_PUBLIC_ONLINE_FIRST=1

# After deploying, apply pending Supabase migrations through 015_rename_islands_to_scenes.sql
# (historical files 004/007/011/013 keep island names in their filenames; live schema is scenes).

# Protects cron routes (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
# /api/cron/content-invalidation — daily at 0 3 * * * (03:00 UTC): content invalidation + Paddle billing reconcile
# CRON_SECRET=



# Optional — only for direct Postgres access (CLI, migrations); not used by the app runtime

# DATABASE_PASSWORD=



# Cloudflare R2 (audio cache). Keys are brand-neutral: audio/{hash}.mp3
# Default bucket name in code: matomari-audio
# To migrate from your current bucket to matomari-audio: create matomari-audio in
# Cloudflare R2, then run `npm run r2-copy-matomari` (copies R2_BUCKET_NAME → matomari-audio).

R2_ACCOUNT_ID=

R2_ACCESS_KEY_ID=

R2_SECRET_ACCESS_KEY=

R2_BUCKET_NAME=matomari-audio



# Fish Audio TTS — chosen for accurate kanji/pitch-accent/intonation on Japanese

FISH_AUDIO_API_KEY=

# Optional — voice model (reference_id) for standard dialect / narration speaker A.
# Defaults to Fish Audio's built-in voice if omitted

FISH_AUDIO_VOICE_ID=

# Optional — separate Fish Audio voice for Kansai dialect / narration speaker A (uses phonetic_reading)

FISH_AUDIO_KANSAI_VOICE_ID=

# Optional — narration speaker B voices (falls back to speaker A for that dialect if omitted)

FISH_AUDIO_VOICE_ID_B=

FISH_AUDIO_KANSAI_VOICE_ID_B=

# Optional — extra Pro narration voice catalog entries (Voice C / D)
# FISH_AUDIO_VOICE_ID_C=
# FISH_AUDIO_VOICE_ID_D=

# Optional — synthesis model sent via the required `model` header (default s2.1-pro-free; paid: s2.1-pro, s2-pro, s1)

# FISH_AUDIO_MODEL=s2.1-pro-free

# Optional — voice expressiveness (defaults tuned for natural learner audio)

# Temperature 0–1 — higher = more expressive/variable delivery (default 0.7)

# FISH_AUDIO_TEMPERATURE=0.7

# Nucleus sampling diversity 0–1 (default 0.7)

# FISH_AUDIO_TOP_P=0.7

# Speed — default 1.0

# FISH_AUDIO_SPEED=1.0

# Volume offset in dB — default 0

# FISH_AUDIO_VOLUME=0



# OpenAI (tutor, scene generation, translation)

OPENAI_API_KEY=

# Optional — defaults to gpt-5.4-mini

OPENAI_MODEL=



# Paddle Billing (sandbox first — https://sandbox-vendors.paddle.com)
#
# Before checkout works, set your default payment link in the Paddle dashboard:
#   Checkout → Checkout settings → Default payment link
# Sandbox: localhost is OK (e.g. http://localhost:3000/pricing)
# Live: must be an approved domain (e.g. https://www.matomari.com/pricing)
#
# Developer Tools → Authentication
# Copy all Paddle vars below to Vercel → Project → Settings → Environment Variables, then redeploy.
#
# Sandbox (Preview / local): NEXT_PUBLIC_PADDLE_ENV=sandbox, pdl_sdbx_… API key, test_… client token
# Production (Vercel Production only): NEXT_PUBLIC_PADDLE_ENV=production, pdl_live_… API key, live_… token
# Use live pri_… price IDs and a live webhook → https://www.matomari.com/api/webhooks/paddle
# Admin → Health shows key/env mismatches and a go-live checklist.

PADDLE_API_KEY=

# Required for Paddle.js pricing page + overlay checkout (test_… sandbox, live_… production)

NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Required — sandbox | production (never omit; avoids hitting the wrong Paddle account)

NEXT_PUBLIC_PADDLE_ENV=sandbox

# Notification destination secret (pdl_ntfset_…)
# Webhook URL: https://www.matomari.com/api/webhooks/paddle

PADDLE_WEBHOOK_SECRET=

# Catalog Price IDs (pri_…) — Plus $8.99/$89.99, Pro $17.99/$179.99

PADDLE_PRICE_PLUS_MONTHLY=pri_01kyh9ye1hx4n4fmer09f3jwpk

PADDLE_PRICE_PLUS_ANNUAL=pri_01kyha3t3305q5x4vvrs8sdcdd

PADDLE_PRICE_PRO_MONTHLY=pri_01kyha8891snn3j1zwnjdcgtr1

PADDLE_PRICE_PRO_ANNUAL=pri_01kyhaa7t2qqff0exnc6xek0x2

