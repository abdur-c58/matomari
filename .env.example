# Supabase (client sync + auth)

NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — use sb_secret_… from Supabase Project Settings → API

SUPABASE_SECRET_KEY=



# Auth.js (Google sign-in for cloud sync)

# Generate with: openssl rand -base64 32

AUTH_SECRET=

AUTH_GOOGLE_ID=

AUTH_GOOGLE_SECRET=

# Legacy aliases also supported: CLIENT_ID, CLIENT_SECRET, BETTER_AUTH_SECRET, NEXTAUTH_SECRET



# Optional — absolute URLs for Open Graph link previews (Discord, WhatsApp, etc.)

# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app



# Optional — only for direct Postgres access (CLI, migrations); not used by the app runtime

# DATABASE_PASSWORD=



# Cloudflare R2 (audio cache)

R2_ACCOUNT_ID=

R2_ACCESS_KEY_ID=

R2_SECRET_ACCESS_KEY=

R2_BUCKET_NAME=



# Fish Audio TTS — chosen for accurate kanji/pitch-accent/intonation on Japanese

FISH_AUDIO_API_KEY=

# Optional — voice model (reference_id) for standard dialect / narration speaker A.
# Defaults to Fish Audio's built-in voice if omitted

FISH_AUDIO_VOICE_ID=

# Optional — separate Fish Audio voice for Kansai dialect / narration speaker A (uses phonetic_reading)

FISH_AUDIO_KANSAI_VOICE_ID=

# Optional — narration speaker B voices (falls back to speaker A for that dialect if omitted)

FISH_AUDIO_VOICE_ID_B=

FISH_AUDIO_KANSAI_VOICE_ID_B=

# Optional — synthesis model sent via the required `model` header (default s2.1-pro-free; paid: s2.1-pro, s2-pro, s1)

# FISH_AUDIO_MODEL=s2.1-pro-free

# Optional — voice expressiveness (defaults tuned for natural learner audio)

# Temperature 0–1 — higher = more expressive/variable delivery (default 0.7)

# FISH_AUDIO_TEMPERATURE=0.7

# Nucleus sampling diversity 0–1 (default 0.7)

# FISH_AUDIO_TOP_P=0.7

# Speed — default 1.0

# FISH_AUDIO_SPEED=1.0

# Volume offset in dB — default 0

# FISH_AUDIO_VOLUME=0



# OpenAI (tutor, island generation, translation)

OPENAI_API_KEY=

# Optional — defaults to gpt-5.4-mini

OPENAI_MODEL=

