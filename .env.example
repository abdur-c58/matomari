# Supabase (client sync + auth)

NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — use sb_secret_… from Supabase Project Settings → API

SUPABASE_SECRET_KEY=



# Auth.js (Google sign-in for cloud sync)

# Generate with: openssl rand -base64 32

AUTH_SECRET=

AUTH_GOOGLE_ID=

AUTH_GOOGLE_SECRET=

# Legacy aliases also supported: CLIENT_ID, CLIENT_SECRET, BETTER_AUTH_SECRET, NEXTAUTH_SECRET



# Optional — only for direct Postgres access (CLI, migrations); not used by the app runtime

# DATABASE_PASSWORD=



# Cloudflare R2 (audio cache)

R2_ACCOUNT_ID=

R2_ACCESS_KEY_ID=

R2_SECRET_ACCESS_KEY=

R2_BUCKET_NAME=



# ElevenLabs TTS

ELEVENLABS_API_KEY=

# Optional — defaults to a built-in voice if omitted

ELEVENLABS_VOICE_ID=

# Optional — voice expressiveness (defaults tuned for natural learner audio)

# Model: eleven_multilingual_v2 (default, natural) or eleven_v3 for more expression

# ELEVENLABS_MODEL=eleven_multilingual_v2

# Stability 0–1 — higher = steadier, less theatrical (default 0.52)

# ELEVENLABS_STABILITY=0.52

# Style 0–1 — keep low for learning audio (default 0.1)

# ELEVENLABS_STYLE=0.1

# Speed — default 1.0

# ELEVENLABS_SPEED=1.0

# ELEVENLABS_SIMILARITY=0.78

# ELEVENLABS_SPEAKER_BOOST=true



# OpenAI (tutor, island generation, translation)

OPENAI_API_KEY=

# Optional — defaults to gpt-5.4

OPENAI_MODEL=

